# =============================================================================
# .env.example -- plantilla de variables de entorno para desarrollo local.
# =============================================================================
# Copiar a .env (gitignorado, nunca se commitea) y completar con valores
# reales de desarrollo/sandbox. NUNCA poner acá credenciales de producción.
#
# Inventario completo de secretos (incluye producción/Render) en:
#   Documentacion/Inventario_Secretos.md
# =============================================================================

# --- Django ---
# Requerida en config.settings.production (falla al importar sin ella,
# #AUD-07/#AUD-12). En development tiene default de desarrollo, no hace
# falta acá salvo que quieras generar la tuya.
SECRET_KEY=django-insecure-solo-para-desarrollo-local-nunca-usar-en-produccion

# --- Cloudinary (media: logos, fotos de galería, imágenes de sección) ---
# Sacar de https://cloudinary.com/console -> Dashboard, plan free alcanza
# para desarrollo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- MercadoPago (checkout de planes) ---
# Credenciales de TEST desde https://www.mercadopago.cl/developers/panel
# -- nunca las de producción en desarrollo local.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=True

# --- Email (Zoho Mail u otro SMTP) ---
# Solo hace falta en development si estás probando el envío real; sin
# esto, EMAIL_BACKEND cae a la consola (ver config/settings/development.py).
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Multi-tenant / dominio base ---
BASE_DOMAIN=localhost
BASE_URL=http://localhost:8000
DEFAULT_TENANT_SLUG=servelec

# --- Otros ---
SUPPORT_EMAIL=soporte@andesscale.cl
